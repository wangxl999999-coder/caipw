<scroll-view class="publish-container" scroll-y="true">
  <view class="publish-section">
    <view class="publish-section-title">菜谱封面</view>
    <view class="publish-cover-upload" bindtap="uploadCover">
      <image wx:if="{{coverImage}}" class="publish-cover-image" src="{{coverImage}}" mode="aspectFill" />
      <view wx:else class="publish-cover-placeholder">
        <icon type="camera" size="40" color="#ccc" />
        <text>点击上传封面</text>
      </view>
    </view>
  </view>

  <view class="publish-section">
    <view class="publish-section-title">基本信息</view>
    <view class="publish-form-item">
      <text class="publish-label">菜谱名称</text>
      <input class="publish-input" placeholder="请输入菜谱名称" value="{{recipeName}}" bindinput="onNameInput" placeholder-style="color:#999" confirm-type="done" />
    </view>
    <view class="publish-form-item">
      <text class="publish-label">菜谱分类</text>
      <picker bindchange="onCategoryChange" value="{{categoryIndex}}" range="{{categories}}">
        <view class="publish-picker">
          {{categories[categoryIndex] || '请选择分类'}}
        </view>
      </picker>
    </view>
    <view class="publish-form-item">
      <text class="publish-label">难度</text>
      <view class="publish-tag-group">
        <text class="publish-tag {{difficulty === '简单' ? 'active' : ''}}" bindtap="selectDifficulty" data-value="简单">简单</text>
        <text class="publish-tag {{difficulty === '中等' ? 'active' : ''}}" bindtap="selectDifficulty" data-value="中等">中等</text>
        <text class="publish-tag {{difficulty === '困难' ? 'active' : ''}}" bindtap="selectDifficulty" data-value="困难">困难</text>
      </view>
    </view>
    <view class="publish-form-item">
      <text class="publish-label">烹饪时间</text>
      <input class="publish-input" placeholder="如：30分钟" value="{{cookTime}}" bindinput="onTimeInput" placeholder-style="color:#999" confirm-type="done" />
    </view>
    <view class="publish-form-item">
      <text class="publish-label">口味</text>
      <view class="publish-tag-group">
        <text class="publish-tag {{taste === '咸鲜' ? 'active' : ''}}" bindtap="selectTaste" data-value="咸鲜">咸鲜</text>
        <text class="publish-tag {{taste === '麻辣' ? 'active' : ''}}" bindtap="selectTaste" data-value="麻辣">麻辣</text>
        <text class="publish-tag {{taste === '酸甜' ? 'active' : ''}}" bindtap="selectTaste" data-value="酸甜">酸甜</text>
        <text class="publish-tag {{taste === '清淡' ? 'active' : ''}}" bindtap="selectTaste" data-value="清淡">清淡</text>
      </view>
    </view>
  </view>

  <view class="publish-section">
    <view class="publish-section-title">食材清单</view>
    <view class="publish-ingredient-list">
      <view class="publish-ingredient-item" wx:for="{{ingredients}}" wx:key="index">
        <input class="publish-ingredient-name" placeholder="食材名称" value="{{item.name}}" bindinput="onIngredientNameInput" data-index="{{index}}" placeholder-style="color:#999" confirm-type="done" />
        <input class="publish-ingredient-amount" placeholder="用量" value="{{item.amount}}" bindinput="onIngredientAmountInput" data-index="{{index}}" placeholder-style="color:#999" confirm-type="done" />
        <icon class="publish-delete-icon" type="cancel" size="16" bindtap="deleteIngredient" data-index="{{index}}" />
      </view>
    </view>
    <button class="publish-add-btn" bindtap="addIngredient">+ 添加食材</button>
  </view>

  <view class="publish-section">
    <view class="publish-section-title">烹饪步骤</view>
    <view class="publish-step-list">
      <view class="publish-step-item" wx:for="{{steps}}" wx:key="index">
        <view class="publish-step-number">第{{index + 1}}步</view>
        <view class="publish-step-image-upload" bindtap="uploadStepImage" data-index="{{index}}">
          <image wx:if="{{item.image}}" class="publish-step-image" src="{{item.image}}" mode="aspectFill" />
          <view wx:else class="publish-step-image-placeholder">
            <icon type="camera" size="20" color="#ccc" />
          </view>
        </view>
        <textarea class="publish-step-desc" placeholder="描述这一步的做法..." value="{{item.description}}" bindinput="onStepDescInput" data-index="{{index}}" placeholder-style="color:#999" auto-height />
        <icon class="publish-delete-step" type="cancel" size="16" bindtap="deleteStep" data-index="{{index}}" />
      </view>
    </view>
    <button class="publish-add-btn" bindtap="addStep">+ 添加步骤</button>
  </view>

  <view class="publish-section">
    <view class="publish-section-title">烹饪小贴士</view>
    <textarea class="publish-textarea" placeholder="分享你的烹饪技巧..." value="{{tips}}" bindinput="onTipsInput" placeholder-style="color:#999" auto-height />
  </view>

  <button class="publish-submit-btn" bindtap="publishRecipe">发布菜谱</button>
  <view class="publish-bottom-spacing"></view>
</scroll-view>
