.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

.form-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 25rpx;
}

.cover-upload {
  width: 100%;
  height: 400rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
  font-size: 26rpx;
}

.cover-placeholder icon {
  margin-bottom: 15rpx;
}

.form-item {
  margin-bottom: 25rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
}

.input {
  width: 100%;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.picker {
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
}

.tag-group {
  display: flex;
  gap: 15rpx;
  flex-wrap: wrap;
}

.tag {
  padding: 12rpx 25rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
}

.tag.active {
  background: #fff0e8;
  color: #ff6b35;
}

.ingredient-list {
  margin-bottom: 20rpx;
}

.ingredient-item {
  display: flex;
  align-items: center;
  gap: 15rpx;
  margin-bottom: 15rpx;
}

.ingredient-name {
  flex: 2;
  padding: 15rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.ingredient-amount {
  flex: 1;
  padding: 15rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.delete-icon {
  color: #ccc;
  flex-shrink: 0;
}

.add-btn {
  width: 100%;
  background: #fff0e8;
  color: #ff6b35;
  border-radius: 8rpx;
  padding: 15rpx;
  font-size: 26rpx;
  border: none;
}

.step-list {
  margin-bottom: 20rpx;
}

.step-item {
  margin-bottom: 25rpx;
  padding-bottom: 25rpx;
  border-bottom: 1rpx solid #f5f5f5;
  position: relative;
}

.step-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.step-number {
  font-size: 26rpx;
  color: #ff6b35;
  font-weight: 500;
  margin-bottom: 15rpx;
}

.step-image-upload {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ddd;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 15rpx;
  overflow: hidden;
}

.step-image {
  width: 100%;
  height: 100%;
}

.step-image-placeholder {
  color: #ccc;
}

.step-desc {
  width: 100%;
  min-height: 150rpx;
  padding: 15rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.delete-step {
  position: absolute;
  top: 0;
  right: 0;
  color: #ccc;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.publish-btn {
  width: 100%;
  background: linear-gradient(135deg, #ff6b35, #ff8f5a);
  color: #fff;
  border-radius: 50rpx;
  padding: 25rpx;
  font-size: 30rpx;
  border: none;
  margin: 20rpx 0;
}

.bottom-spacing {
  height: 40rpx;
}
