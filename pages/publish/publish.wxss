.publish-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
  box-sizing: border-box;
}

.publish-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.publish-section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 25rpx;
  display: block;
  line-height: 1.5;
}

.publish-cover-upload {
  width: 100%;
  height: 400rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-sizing: border-box;
}

.publish-cover-image {
  width: 100%;
  height: 100%;
  display: block;
}

.publish-cover-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
  font-size: 26rpx;
}

.publish-cover-placeholder icon {
  margin-bottom: 15rpx;
}

.publish-form-item {
  margin-bottom: 25rpx;
  display: block;
}

.publish-form-item:last-child {
  margin-bottom: 0;
}

.publish-label {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.publish-input {
  width: 100% !important;
  padding: 24rpx 20rpx !important;
  background: #f8f8f8 !important;
  border-radius: 12rpx !important;
  font-size: 28rpx !important;
  color: #333 !important;
  box-sizing: border-box !important;
  border: none !important;
  display: block !important;
  line-height: 1.5 !important;
  height: auto !important;
}

.publish-picker {
  width: 100%;
  padding: 24rpx 20rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  display: block;
  line-height: 1.5;
}

.publish-tag-group {
  display: flex;
  gap: 15rpx;
  flex-wrap: wrap;
}

.publish-tag {
  padding: 12rpx 25rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  display: inline-block;
}

.publish-tag.active {
  background: #fff0e8;
  color: #ff6b35;
}

.publish-ingredient-list {
  margin-bottom: 20rpx;
}

.publish-ingredient-item {
  display: flex;
  align-items: center;
  gap: 15rpx;
  margin-bottom: 15rpx;
}

.publish-ingredient-name {
  flex: 2;
  padding: 20rpx 16rpx !important;
  background: #f8f8f8 !important;
  border-radius: 10rpx !important;
  font-size: 26rpx !important;
  color: #333 !important;
  box-sizing: border-box !important;
  border: none !important;
  display: block !important;
}

.publish-ingredient-amount {
  flex: 1;
  padding: 20rpx 16rpx !important;
  background: #f8f8f8 !important;
  border-radius: 10rpx !important;
  font-size: 26rpx !important;
  color: #333 !important;
  box-sizing: border-box !important;
  border: none !important;
  display: block !important;
}

.publish-delete-icon {
  color: #ccc;
  flex-shrink: 0;
}

.publish-add-btn {
  width: 100%;
  background: #fff0e8;
  color: #ff6b35;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  border: none;
  display: block;
  line-height: 1.5;
}

.publish-step-list {
  margin-bottom: 20rpx;
}

.publish-step-item {
  margin-bottom: 25rpx;
  padding-bottom: 25rpx;
  border-bottom: 1rpx solid #f5f5f5;
  position: relative;
  display: block;
}

.publish-step-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.publish-step-number {
  font-size: 26rpx;
  color: #ff6b35;
  font-weight: 500;
  margin-bottom: 15rpx;
  display: block;
  line-height: 1.5;
}

.publish-step-image-upload {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ddd;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 15rpx;
  overflow: hidden;
}

.publish-step-image {
  width: 100%;
  height: 100%;
  display: block;
}

.publish-step-image-placeholder {
  color: #ccc;
}

.publish-step-desc {
  width: 100% !important;
  min-height: 160rpx !important;
  padding: 20rpx !important;
  background: #f8f8f8 !important;
  border-radius: 10rpx !important;
  font-size: 26rpx !important;
  color: #333 !important;
  box-sizing: border-box !important;
  border: none !important;
  display: block !important;
  line-height: 1.6 !important;
}

.publish-delete-step {
  position: absolute;
  top: 0;
  right: 0;
  color: #ccc;
}

.publish-textarea {
  width: 100% !important;
  min-height: 200rpx !important;
  padding: 24rpx 20rpx !important;
  background: #f8f8f8 !important;
  border-radius: 12rpx !important;
  font-size: 28rpx !important;
  color: #333 !important;
  box-sizing: border-box !important;
  border: none !important;
  display: block !important;
  line-height: 1.6 !important;
}

.publish-submit-btn {
  width: 100%;
  background: linear-gradient(135deg, #ff6b35, #ff8f5a);
  color: #fff;
  border-radius: 50rpx;
  padding: 25rpx;
  font-size: 30rpx;
  border: none;
  margin: 20rpx 0;
  display: block;
  line-height: 1.5;
}

.publish-bottom-spacing {
  height: 60rpx;
  display: block;
}
