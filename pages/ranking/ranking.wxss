.container {
  padding: 20rpx;
}

.tabs {
  display: flex;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 8rpx;
  margin-bottom: 30rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 15rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 8rpx;
}

.tab.active {
  background: #fff;
  color: #ff6b35;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.top-three {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
  padding: 20rpx 0;
}

.top-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  width: 200rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  position: relative;
}

.top-1 {
  width: 220rpx;
  height: 320rpx;
}

.top-2, .top-3 {
  height: 280rpx;
}

.rank-badge {
  position: absolute;
  top: -10rpx;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  color: #fff;
}

.top-1 .rank-badge {
  background: linear-gradient(135deg, #ffd700, #ffb700);
}

.top-2 .rank-badge {
  background: linear-gradient(135deg, #c0c0c0, #a0a0a0);
}

.top-3 .rank-badge {
  background: linear-gradient(135deg, #cd7f32, #b87333);
}

.top-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  margin-bottom: 15rpx;
}

.top-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  text-align: center;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
}

.top-count {
  font-size: 22rpx;
  color: #ff6b35;
}

.ranking-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.ranking-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.rank-number {
  width: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #999;
  text-align: center;
  margin-right: 15rpx;
}

.item-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}

.item-info {
  flex: 1;
}

.item-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}

.item-author {
  font-size: 24rpx;
  color: #999;
}

.item-count {
  font-size: 24rpx;
  color: #ff6b35;
}

.author-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.author-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.author-rank {
  width: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #999;
  text-align: center;
  margin-right: 15rpx;
}

.author-rank.top {
  color: #ff6b35;
}

.author-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.author-info {
  flex: 1;
}

.author-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}

.author-stats {
  font-size: 22rpx;
  color: #999;
}

.follow-btn {
  background: #fff0e8;
  color: #ff6b35;
  border: none;
  font-size: 24rpx;
}
