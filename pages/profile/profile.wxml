<view class="container">
  <view class="profile-header">
    <image class="avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
    <view class="user-info" wx:if="{{isLogin}}">
      <text class="username">{{userInfo.nickname || '美食爱好者'}}</text>
      <text class="user-id">ID: {{userInfo.id}}</text>
    </view>
    <view class="user-info" wx:else>
      <text class="username" bindtap="goToLogin">点击登录</text>
      <text class="user-desc">登录后体验更多功能</text>
    </view>
    <icon class="settings-icon" type="info" size="24" bindtap="goToSettings" />
  </view>

  <view class="stats-row" wx:if="{{isLogin}}">
    <view class="stat-item">
      <text class="stat-value">{{stats.recipes}}</text>
      <text class="stat-label">菜谱</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{stats.favorites}}</text>
      <text class="stat-label">收藏</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{stats.followers}}</text>
      <text class="stat-label">粉丝</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{stats.following}}</text>
      <text class="stat-label">关注</text>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-title">我的内容</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goToMyRecipes">
        <view class="menu-icon">📝</view>
        <text class="menu-name">我的菜谱</text>
        <icon class="menu-arrow" type="info" size="16" />
      </view>
      <view class="menu-item" bindtap="goToFavorites">
        <view class="menu-icon">⭐</view>
        <text class="menu-name">我的收藏</text>
        <icon class="menu-arrow" type="info" size="16" />
      </view>
      <view class="menu-item" bindtap="goToHistory">
        <view class="menu-icon">👁️</view>
        <text class="menu-name">浏览记录</text>
        <icon class="menu-arrow" type="info" size="16" />
      </view>
      <view class="menu-item" bindtap="goToCheckIn">
        <view class="menu-icon">📅</view>
        <text class="menu-name">我的打卡</text>
        <icon class="menu-arrow" type="info" size="16" />
      </view>
      <view class="menu-item" bindtap="goToMyPlan">
        <view class="menu-icon">📋</view>
        <text class="menu-name">我的食谱计划</text>
        <icon class="menu-arrow" type="info" size="16" />
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-title">其他功能</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goToPublish">
        <view class="menu-icon">✏️</view>
        <text class="menu-name">发布菜谱</text>
        <icon class="menu-arrow" type="info" size="16" />
      </view>
      <view class="menu-item" bindtap="goToFeedback">
        <view class="menu-icon">💬</view>
        <text class="menu-name">意见反馈</text>
        <icon class="menu-arrow" type="info" size="16" />
      </view>
      <view class="menu-item" bindtap="goToSettings">
        <view class="menu-icon">⚙️</view>
        <text class="menu-name">设置</text>
        <icon class="menu-arrow" type="info" size="16" />
      </view>
    </view>
  </view>

  <view class="logout-btn" wx:if="{{isLogin}}" bindtap="logout">
    退出登录
  </view>

  <view class="bottom-spacing"></view>
</view>
