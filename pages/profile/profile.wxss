.container {
  background: #f5f5f5;
  min-height: 100vh;
}

.profile-header {
  background: linear-gradient(135deg, #ff6b35, #ff8f5a);
  padding: 60rpx 30rpx 40rpx;
  display: flex;
  align-items: center;
  position: relative;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  margin-right: 25rpx;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
}

.username {
  font-size: 36rpx;
  font-weight: 500;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}

.user-id, .user-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.settings-icon {
  color: #fff;
}

.stats-row {
  display: flex;
  background: #fff;
  margin: -20rpx 20rpx 20rpx;
  border-radius: 16rpx;
  padding: 30rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 1;
}

.stat-item {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #f5f5f5;
}

.stat-item:last-child {
  border-right: none;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.menu-section {
  margin: 0 20rpx 20rpx;
}

.menu-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 15rpx;
  padding-left: 10rpx;
}

.menu-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 25rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 50rpx;
  text-align: center;
}

.menu-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  color: #ccc;
}

.logout-btn {
  margin: 40rpx 20rpx;
  padding: 25rpx;
  background: #fff;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  color: #f44336;
}

.bottom-spacing {
  height: 40rpx;
}
