<view class="container">
  <image class="recipe-main-image" src="{{recipe.image}}" mode="aspectFill" />
  
  <view class="recipe-header">
    <view class="recipe-title">{{recipe.title}}</view>
    <view class="recipe-author">
      <image class="author-avatar" src="{{recipe.authorAvatar}}" />
      <text class="author-name">{{recipe.author}}</text>
    </view>
    <view class="recipe-stats">
      <view class="stat-item">
        <text class="stat-icon">❤️</text>
        <text class="stat-value">{{formatCount(recipe.likes)}}</text>
      </view>
      <view class="stat-item">
        <text class="stat-icon">⭐</text>
        <text class="stat-value">{{formatCount(recipe.favorites)}}</text>
      </view>
      <view class="stat-item">
        <text class="stat-icon">👁️</text>
        <text class="stat-value">{{formatCount(recipe.views)}}</text>
      </view>
    </view>
  </view>

  <view class="recipe-info card">
    <view class="info-item">
      <text class="info-label">难度</text>
      <text class="info-value">{{recipe.difficulty}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">耗时</text>
      <text class="info-value">{{recipe.time}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">口味</text>
      <text class="info-value">{{recipe.taste}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">适用</text>
      <text class="info-value">{{recipe.suitable}}</text>
    </view>
  </view>

  <view class="section-title">食材清单</view>
  <view class="ingredients-section card">
    <view class="ingredient-category">
      <view class="category-title">主料</view>
      <view class="ingredient-list">
        <view class="ingredient-item" wx:for="{{recipe.ingredients.main}}" wx:key="name">
          <text class="ingredient-name">{{item.name}}</text>
          <text class="ingredient-amount">{{item.amount}}</text>
        </view>
      </view>
    </view>
    <view class="ingredient-category" wx:if="{{recipe.ingredients.auxiliary.length > 0}}">
      <view class="category-title">辅料</view>
      <view class="ingredient-list">
        <view class="ingredient-item" wx:for="{{recipe.ingredients.auxiliary}}" wx:key="name">
          <text class="ingredient-name">{{item.name}}</text>
          <text class="ingredient-amount">{{item.amount}}</text>
        </view>
      </view>
    </view>
    <view class="ingredient-category">
      <view class="category-title">调料</view>
      <view class="ingredient-list">
        <view class="ingredient-item" wx:for="{{recipe.ingredients.seasoning}}" wx:key="name">
          <text class="ingredient-name">{{item.name}}</text>
          <text class="ingredient-amount">{{item.amount}}</text>
        </view>
      </view>
    </view>
    <button class="add-shopping-btn" bindtap="addToShoppingList">加入购物清单</button>
  </view>

  <view class="section-title">烹饪步骤</view>
  <view class="steps-section">
    <view class="step-item" wx:for="{{recipe.steps}}" wx:key="order">
      <view class="step-number">{{item.order}}</view>
      <view class="step-content">
        <image class="step-image" src="{{item.image}}" mode="aspectFill" />
        <text class="step-description">{{item.description}}</text>
      </view>
    </view>
  </view>

  <view class="tips-section card">
    <view class="tips-title">💡 烹饪小贴士</view>
    <view class="tip-item" wx:for="{{recipe.tips}}" wx:key="index">
      <text class="tip-dot">•</text>
      <text class="tip-text">{{item}}</text>
    </view>
  </view>

  <view class="pitfalls-section card">
    <view class="pitfalls-title">⚠️ 避坑技巧</view>
    <view class="pitfall-item" wx:for="{{recipe.pitfalls}}" wx:key="index">
      <text class="pitfall-dot">•</text>
      <text class="pitfall-text">{{item}}</text>
    </view>
  </view>

  <view class="video-section card">
    <view class="video-content" bindtap="playVideo">
      <icon class="play-icon" type="info_circle" size="50"></icon>
      <text class="video-text">点击观看视频教程</text>
    </view>
  </view>

  <view class="comment-section card">
    <view class="section-title">
      <text>评论 ({{comments.length}})</text>
      <text class="more" bindtap="goToComment">查看全部</text>
    </view>
    <view class="comment-list">
      <view class="comment-item" wx:for="{{comments}}" wx:key="id" wx:if="{{index < 3}}">
        <image class="comment-avatar" src="{{item.avatar}}" />
        <view class="comment-content">
          <view class="comment-header">
            <text class="comment-user">{{item.user}}</text>
            <text class="comment-time">{{item.time}}</text>
          </view>
          <text class="comment-text">{{item.content}}</text>
          <view class="comment-actions">
            <text class="comment-like">👍 {{item.likes}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-spacing"></view>
</view>

<view class="bottom-bar">
  <view class="action-item" bindtap="toggleFavorite">
    <icon class="action-icon {{isFavorited ? 'favorited' : ''}}" type="{{isFavorited ? 'warn' : 'info'}}" size="24"></icon>
    <text class="action-text">{{isFavorited ? '已收藏' : '收藏'}}</text>
  </view>
  <view class="action-item" bindtap="toggleLike">
    <icon class="action-icon {{isLiked ? 'liked' : ''}}" type="{{isLiked ? 'warn' : 'info'}}" size="24"></icon>
    <text class="action-text">{{isLiked ? '已点赞' : '点赞'}}</text>
  </view>
  <view class="action-item" bindtap="shareRecipe">
    <icon class="action-icon" type="info" size="24"></icon>
    <text class="action-text">分享</text>
  </view>
  <button class="cook-btn" open-type="share">开始做菜</button>
</view>
