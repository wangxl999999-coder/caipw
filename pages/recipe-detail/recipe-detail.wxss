.container {
  padding-bottom: 140rpx;
}

.recipe-main-image {
  width: 100%;
  height: 500rpx;
  display: block;
}

.recipe-header {
  background: #fff;
  padding: 30rpx;
  margin-top: -40rpx;
  border-radius: 30rpx 30rpx 0 0;
  position: relative;
}

.recipe-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.recipe-author {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.author-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 15rpx;
}

.author-name {
  font-size: 26rpx;
  color: #666;
}

.recipe-stats {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  border-top: 1rpx solid #f5f5f5;
}

.stat-item {
  display: flex;
  align-items: center;
  flex-direction: column;
}

.stat-icon {
  font-size: 32rpx;
  margin-bottom: 5rpx;
}

.stat-value {
  font-size: 24rpx;
  color: #999;
}

.recipe-info {
  display: flex;
  flex-wrap: wrap;
  padding: 30rpx;
  margin: 20rpx;
}

.info-item {
  width: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  padding: 30rpx 30rpx 20rpx;
}

.ingredients-section {
  margin: 0 20rpx 30rpx;
  padding: 30rpx;
}

.ingredient-category {
  margin-bottom: 30rpx;
}

.ingredient-category:last-child {
  margin-bottom: 0;
}

.category-title {
  font-size: 28rpx;
  color: #ff6b35;
  font-weight: 500;
  margin-bottom: 15rpx;
}

.ingredient-list {
  display: flex;
  flex-wrap: wrap;
}

.ingredient-item {
  width: 50%;
  display: flex;
  justify-content: space-between;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.ingredient-name {
  font-size: 26rpx;
  color: #333;
}

.ingredient-amount {
  font-size: 26rpx;
  color: #999;
}

.add-shopping-btn {
  width: 100%;
  background: #fff0e8;
  color: #ff6b35;
  border-radius: 50rpx;
  padding: 20rpx;
  font-size: 28rpx;
  margin-top: 20rpx;
  border: none;
}

.steps-section {
  padding: 0 20rpx;
}

.step-item {
  display: flex;
  margin-bottom: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.step-number {
  width: 80rpx;
  background: linear-gradient(135deg, #ff6b35, #ff8f5a);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.step-content {
  flex: 1;
  padding: 20rpx;
}

.step-image {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  margin-bottom: 15rpx;
}

.step-description {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.tips-section, .pitfalls-section {
  margin: 30rpx 20rpx;
  padding: 30rpx;
}

.tips-title, .pitfalls-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

.tip-item, .pitfall-item {
  display: flex;
  margin-bottom: 15rpx;
}

.tip-item:last-child, .pitfall-item:last-child {
  margin-bottom: 0;
}

.tip-dot, .pitfall-dot {
  color: #ff6b35;
  margin-right: 10rpx;
  font-size: 26rpx;
}

.tip-text, .pitfall-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  flex: 1;
}

.video-section {
  margin: 30rpx 20rpx;
  padding: 0;
  overflow: hidden;
}

.video-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.play-icon {
  color: #fff;
  margin-bottom: 15rpx;
}

.video-text {
  color: #fff;
  font-size: 28rpx;
}

.comment-section {
  margin: 30rpx 20rpx;
  padding: 30rpx;
}

.comment-section .section-title {
  padding: 0 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.comment-section .more {
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
}

.comment-list {
  display: flex;
  flex-direction: column;
  gap: 25rpx;
}

.comment-item {
  display: flex;
}

.comment-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.comment-content {
  flex: 1;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.comment-user {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.comment-time {
  font-size: 22rpx;
  color: #999;
}

.comment-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 10rpx;
}

.comment-actions {
  display: flex;
}

.comment-like {
  font-size: 24rpx;
  color: #999;
}

.bottom-spacing {
  height: 40rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 50rpx;
}

.action-icon {
  margin-bottom: 5rpx;
}

.action-icon.favorited, .action-icon.liked {
  color: #ff6b35;
}

.action-text {
  font-size: 22rpx;
  color: #666;
}

.cook-btn {
  flex: 1;
  background: linear-gradient(135deg, #ff6b35, #ff8f5a);
  color: #fff;
  border-radius: 50rpx;
  padding: 20rpx;
  font-size: 30rpx;
  border: none;
}
