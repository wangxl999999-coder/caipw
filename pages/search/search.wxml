<view class="container">
  <view class="search-header">
    <view class="search-input-wrapper">
      <icon class="search-icon" type="search" size="16"></icon>
      <input class="search-input" placeholder="输入菜谱名称或食材" value="{{searchKeyword}}" bindinput="onInput" bindconfirm="onSearch" focus />
      <text class="clear-btn" wx:if="{{searchKeyword}}" bindtap="clearSearch">✕</text>
    </view>
    <text class="cancel-btn" bindtap="goBack">取消</text>
  </view>

  <view class="search-mode">
    <view class="mode-tab {{searchMode === 'recipe' ? 'active' : ''}}" bindtap="switchMode" data-mode="recipe">
      按菜谱搜索
    </view>
    <view class="mode-tab {{searchMode === 'ingredient' ? 'active' : ''}}" bindtap="switchMode" data-mode="ingredient">
      按食材匹配
    </view>
  </view>

  <view class="ingredient-input" wx:if="{{searchMode === 'ingredient'}}">
    <view class="selected-ingredients">
      <view class="ingredient-tag" wx:for="{{selectedIngredients}}" wx:key="index">
        {{item}}
        <text class="remove-tag" bindtap="removeIngredient" data-index="{{index}}">✕</text>
      </view>
    </view>
    <view class="ingredient-input-row">
      <input class="ingredient-input-field" placeholder="输入食材名称，按回车添加" bindconfirm="addIngredient" />
      <button class="add-btn" bindtap="addIngredient">添加</button>
    </view>
  </view>

  <view class="search-results" wx:if="{{searchResults.length > 0}}">
    <view class="result-title">找到 {{searchResults.length}} 个菜谱</view>
    <view class="result-list">
      <view class="result-item" wx:for="{{searchResults}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
        <image class="result-image" src="{{item.image}}" mode="aspectFill" />
        <view class="result-content">
          <text class="result-title">{{item.title}}</text>
          <view class="result-tags">
            <text class="tag">{{item.category}}</text>
            <text class="tag">{{item.difficulty}}</text>
          </view>
          <view class="result-meta">
            <text>⏱️ {{item.time}}</text>
            <text>❤️ {{formatCount(item.likes)}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="search-suggestions" wx:if="{{!searchKeyword && searchResults.length === 0 && selectedIngredients.length === 0}}">
    <view class="suggestion-section">
      <view class="suggestion-title">热门搜索</view>
      <view class="suggestion-tags">
        <text class="suggestion-tag" wx:for="{{hotSearches}}" wx:key="index" bindtap="searchTag" data-keyword="{{item}}">
          {{item}}
        </text>
      </view>
    </view>

    <view class="suggestion-section" wx:if="{{searchHistory.length > 0}}">
      <view class="suggestion-header">
        <text class="suggestion-title">搜索历史</text>
        <text class="clear-history" bindtap="clearHistory">清空</text>
      </view>
      <view class="suggestion-tags">
        <text class="suggestion-tag" wx:for="{{searchHistory}}" wx:key="index" bindtap="searchTag" data-keyword="{{item}}">
          {{item}}
        </text>
      </view>
    </view>

    <view class="suggestion-section">
      <view class="suggestion-title">常见食材</view>
      <view class="suggestion-tags">
        <text class="suggestion-tag" wx:for="{{commonIngredients}}" wx:key="index" bindtap="quickAddIngredient" data-ingredient="{{item}}">
          {{item}}
        </text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{searchKeyword && searchResults.length === 0}}">
    <text class="empty-text">没有找到相关菜谱</text>
    <text class="empty-hint">试试换个关键词搜索吧</text>
  </view>
</view>
