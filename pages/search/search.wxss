.container {
  padding: 20rpx;
  padding-bottom: 40rpx;
}

.search-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 50rpx;
  padding: 15rpx 25rpx;
}

.search-icon {
  margin-right: 15rpx;
  color: #999;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.clear-btn {
  font-size: 24rpx;
  color: #999;
  padding: 10rpx;
}

.cancel-btn {
  font-size: 28rpx;
  color: #ff6b35;
  margin-left: 20rpx;
}

.search-mode {
  display: flex;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 8rpx;
  margin-bottom: 30rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 15rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.mode-tab.active {
  background: #fff;
  color: #ff6b35;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.ingredient-input {
  margin-bottom: 30rpx;
}

.selected-ingredients {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  margin-bottom: 20rpx;
}

.ingredient-tag {
  display: flex;
  align-items: center;
  background: #fff0e8;
  color: #ff6b35;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
}

.remove-tag {
  margin-left: 10rpx;
  font-size: 20rpx;
}

.ingredient-input-row {
  display: flex;
  gap: 15rpx;
}

.ingredient-input-field {
  flex: 1;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
}

.add-btn {
  background: #ff6b35;
  color: #fff;
  border-radius: 12rpx;
  padding: 20rpx 30rpx;
  font-size: 26rpx;
  border: none;
}

.search-results {
  margin-top: 20rpx;
}

.result-title {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.result-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.result-image {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.result-content {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.result-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.result-tags {
  display: flex;
  gap: 10rpx;
}

.result-meta {
  display: flex;
  gap: 30rpx;
  font-size: 24rpx;
  color: #999;
}

.search-suggestions {
  margin-top: 20rpx;
}

.suggestion-section {
  margin-bottom: 40rpx;
}

.suggestion-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.suggestion-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

.suggestion-header .suggestion-title {
  margin-bottom: 0;
}

.clear-history {
  font-size: 24rpx;
  color: #999;
}

.suggestion-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.suggestion-tag {
  background: #f5f5f5;
  color: #666;
  padding: 15rpx 25rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-text {
  display: block;
  font-size: 30rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
}
