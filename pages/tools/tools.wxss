.container {
  padding: 20rpx;
}

.tools-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.tool-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.tool-icon {
  font-size: 60rpx;
  margin-bottom: 15rpx;
}

.tool-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.tool-desc {
  font-size: 22rpx;
  color: #999;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.clear-all {
  font-size: 24rpx;
  color: #ff6b35;
  font-weight: normal;
}

.converter-card, .timer-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.input-group {
  margin-bottom: 30rpx;
}

.label {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
}

.input {
  width: 100%;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.unit-select {
  display: flex;
  gap: 15rpx;
  margin-bottom: 20rpx;
}

.unit-option {
  flex: 1;
  text-align: center;
  padding: 15rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.unit-option.active {
  background: #ff6b35;
  color: #fff;
}

.converter-arrow {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin: 15rpx 0;
}

.result-box {
  text-align: center;
  padding: 30rpx;
  background: #fff0e8;
  border-radius: 12rpx;
  margin-bottom: 15rpx;
}

.result-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff6b35;
  margin-right: 10rpx;
}

.result-unit {
  font-size: 28rpx;
  color: #ff6b35;
}

.convert-tips {
  font-size: 22rpx;
  color: #999;
  text-align: center;
}

.timer-display {
  font-size: 100rpx;
  font-weight: bold;
  text-align: center;
  color: #ff6b35;
  font-family: monospace;
  margin-bottom: 30rpx;
}

.timer-controls {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.timer-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
}

.timer-btn.start {
  background: linear-gradient(135deg, #ff6b35, #ff8f5a);
  color: #fff;
}

.timer-btn.pause {
  background: #ffb74d;
  color: #fff;
}

.timer-btn.reset {
  background: #f5f5f5;
  color: #666;
}

.preset-times, .custom-time {
  margin-bottom: 25rpx;
}

.preset-title {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 15rpx;
}

.preset-list {
  display: flex;
  gap: 15rpx;
  flex-wrap: wrap;
}

.preset-item {
  padding: 12rpx 25rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
}

.time-inputs {
  display: flex;
  align-items: center;
  gap: 15rpx;
  margin-bottom: 15rpx;
}

.time-input {
  flex: 1;
  padding: 15rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  text-align: center;
  font-size: 28rpx;
}

.time-separator {
  font-size: 32rpx;
  color: #999;
}

.set-time-btn {
  width: 100%;
  background: #fff0e8;
  color: #ff6b35;
  border-radius: 12rpx;
  padding: 15rpx;
  font-size: 26rpx;
  border: none;
}

.add-item-row {
  display: flex;
  gap: 15rpx;
  margin-bottom: 20rpx;
}

.add-input {
  flex: 1;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.add-btn {
  background: #ff6b35;
  color: #fff;
  border-radius: 12rpx;
  padding: 20rpx 30rpx;
  font-size: 26rpx;
  border: none;
}

.shopping-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.shopping-item {
  display: flex;
  align-items: center;
  padding: 25rpx 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.shopping-item:last-child {
  border-bottom: none;
}

.shopping-item.checked .item-name {
  text-decoration: line-through;
  color: #ccc;
}

.item-checkbox {
  margin-right: 15rpx;
}

.item-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.item-delete {
  color: #ccc;
}

.export-btn {
  width: 100%;
  background: linear-gradient(135deg, #ff6b35, #ff8f5a);
  color: #fff;
  border-radius: 50rpx;
  padding: 25rpx;
  font-size: 28rpx;
  border: none;
  margin-top: 20rpx;
}

.empty-shopping {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 26rpx;
  background: #fff;
  border-radius: 16rpx;
}
