.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.category-tabs {
  display: flex;
  background: #fff;
  padding: 20rpx;
  gap: 15rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.tab {
  padding: 15rpx 30rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
}

.tab.active {
  background: #ff6b35;
  color: #fff;
}

.favorites-list {
  flex: 1;
  padding: 20rpx;
}

.favorite-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  position: relative;
}

.favorite-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.favorite-content {
  flex: 1;
}

.favorite-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 10rpx;
}

.favorite-meta {
  display: flex;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.favorite-time {
  font-size: 24rpx;
  color: #999;
}

.delete-icon {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  color: #ccc;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  display: block;
  font-size: 30rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.empty-hint {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.go-explore-btn {
  background: linear-gradient(135deg, #ff6b35, #ff8f5a);
  color: #fff;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 28rpx;
  border: none;
}
