<view class="container">
  <view class="comment-header">
    <text class="comment-count">全部评论 ({{comments.length}})</text>
  </view>

  <view class="comment-list">
    <view class="comment-item" wx:for="{{comments}}" wx:key="id">
      <image class="comment-avatar" src="{{item.avatar}}" mode="aspectFill" />
      <view class="comment-content">
        <view class="comment-top">
          <text class="comment-user">{{item.user}}</text>
          <text class="comment-time">{{item.time}}</text>
        </view>
        <text class="comment-text">{{item.content}}</text>
        <view class="comment-actions">
          <view class="action-item" bindtap="likeComment" data-index="{{index}}">
            <text class="action-icon">👍</text>
            <text class="action-count">{{item.likes}}</text>
          </view>
          <view class="action-item" bindtap="replyComment">
            <text class="action-icon">💬</text>
            <text class="action-text">回复</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="input-area">
    <input class="comment-input" placeholder="发表你的评论..." value="{{inputText}}" bindinput="onInput" />
    <button class="send-btn" bindtap="sendComment" disabled="{{!inputText.trim()}}">发送</button>
  </view>
</view>
