.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
}

.comment-header {
  padding: 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #f5f5f5;
}

.comment-count {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.comment-list {
  padding: 20rpx;
}

.comment-item {
  display: flex;
  margin-bottom: 30rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
}

.comment-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.comment-content {
  flex: 1;
}

.comment-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.comment-user {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.comment-time {
  font-size: 22rpx;
  color: #999;
}

.comment-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 15rpx;
}

.comment-actions {
  display: flex;
  gap: 30rpx;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 5rpx;
}

.action-icon {
  font-size: 24rpx;
}

.action-count, .action-text {
  font-size: 22rpx;
  color: #999;
}

.input-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx;
  display: flex;
  align-items: center;
  gap: 15rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.comment-input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 30rpx;
  padding: 15rpx 25rpx;
  font-size: 26rpx;
}

.send-btn {
  background: #ff6b35;
  color: #fff;
  border-radius: 30rpx;
  padding: 15rpx 30rpx;
  font-size: 26rpx;
  border: none;
}

.send-btn[disabled] {
  background: #ccc;
}
