.container {
  padding: 20rpx;
  padding-bottom: 120rpx;
}

.search-bar {
  margin-bottom: 30rpx;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 50rpx;
  padding: 20rpx 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.search-icon {
  margin-right: 15rpx;
  color: #999;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.category-scroll {
  margin-bottom: 30rpx;
  white-space: nowrap;
}

.category-list {
  display: flex;
  padding: 0 10rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 40rpx;
}

.category-icon {
  width: 100rpx;
  height: 100rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.category-name {
  font-size: 24rpx;
  color: #666;
}

.banner-swiper {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 40rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-title {
  position: absolute;
  bottom: 20rpx;
  left: 30rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title .more {
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
}

.recipe-scroll {
  white-space: nowrap;
}

.recipe-list {
  display: flex;
}

.recipe-card {
  width: 280rpx;
  margin-right: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.recipe-image {
  width: 280rpx;
  height: 200rpx;
}

.recipe-info {
  padding: 20rpx;
}

.recipe-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recipe-meta {
  display: flex;
  justify-content: space-between;
}

.meta-item {
  font-size: 22rpx;
  color: #999;
}

.today-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.today-item {
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
  height: 200rpx;
}

.today-image {
  width: 100%;
  height: 100%;
}

.today-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
  color: #fff;
}

.today-title {
  font-size: 28rpx;
  font-weight: 500;
  display: block;
  margin-bottom: 5rpx;
}

.today-author {
  font-size: 22rpx;
  opacity: 0.8;
}

.season-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.season-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.season-image {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.season-content {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.season-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.season-tags {
  margin: 10rpx 0;
}

.season-stats {
  display: flex;
  gap: 30rpx;
  font-size: 24rpx;
  color: #999;
}

.guess-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.guess-item {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.guess-image {
  width: 100%;
  height: 200rpx;
}

.guess-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  padding: 15rpx 20rpx 10rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.guess-meta {
  display: flex;
  justify-content: space-between;
  padding: 0 20rpx 15rpx;
  font-size: 22rpx;
  color: #999;
}

.beginner-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.beginner-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.beginner-number {
  width: 50rpx;
  height: 50rpx;
  background: linear-gradient(135deg, #ff6b35, #ff8f5a);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: bold;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.beginner-content {
  flex: 1;
}

.beginner-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}

.beginner-tags {
  display: flex;
  gap: 10rpx;
}

.beginner-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
